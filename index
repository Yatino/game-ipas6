    const zones = [
      { icon: "🌱", name: "EKOSISTEM", range: "Misi 1–6", level: "LEVEL 1 – PENJELAJAH EKOSISTEM" },
      { icon: "💧", name: "LINGKUNGAN", range: "Misi 7–12", level: "LEVEL 2 – PELINDUNG LINGKUNGAN" },
      { icon: "⚡", name: "ENERGI", range: "Misi 13–18", level: "LEVEL 3 – MASTER ENERGI" },
      { icon: "🌏", name: "BUMI", range: "Misi 19–25", level: "LEVEL 4 – PENJAGA BUMI" }
    ];

    const state = {
      playerName: "",
      gameQuestions: [],
      currentIndex: 0,
      score: 0,
      lives: 3,
      combo: 0,
      maxCombo: 0,
      correct: 0,
      wrong: 0,
      timeLeft: 30,
      timer: null,
      answered: false,
      hintUsed: false,
      soundOn: localStorage.getItem("misiSound") !== "off",
      audioContext: null
    };

    const $ = (id) => document.getElementById(id);

    function shuffle(array) {
      const copied = [...array];
      for (let i = copied.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copied[i], copied[j]] = [copied[j], copied[i]];
      }
      return copied;
    }

    function prepareQuestions() {
      state.gameQuestions = shuffle(questions).map((question) => {
        const shuffledOptions = shuffle(
          question.options.map((text, index) => ({
            text,
            isCorrect: index === question.answer
          }))
        );

        return {
          ...question,
          options: shuffledOptions.map((item) => item.text),
          answer: shuffledOptions.findIndex((item) => item.isCorrect)
        };
      });
    }

    function loadHighScore() {
      return Number(localStorage.getItem("misiHighScore") || 0);
    }

    function saveHighScore() {
      const previous = loadHighScore();
      const isNewRecord = state.score > previous;
      if (isNewRecord) {
        localStorage.setItem("misiHighScore", String(state.score));
      }

      const oldCombo = Number(localStorage.getItem("misiMaxCombo") || 0);
      if (state.maxCombo > oldCombo) {
        localStorage.setItem("misiMaxCombo", String(state.maxCombo));
      }

      const games = Number(localStorage.getItem("misiGamesPlayed") || 0) + 1;
      localStorage.setItem("misiGamesPlayed", String(games));
      return isNewRecord;
    }

    function loadStartRecords() {
      $("highScoreStart").textContent = loadHighScore().toLocaleString("id-ID");
      const games = Number(localStorage.getItem("misiGamesPlayed") || 0);
      $("gamesPlayedStart").textContent = games ? `🎮 Sudah dimainkan ${games} kali` : "🎮 Jadilah Penjaga Bumi pertama!";
      $("studentName").value = localStorage.getItem("misiLastName") || "";
    }

    function startGame() {
      const name = $("studentName").value.trim();
      if (!name) {
        $("studentName").focus();
        showToast("Tuliskan namamu dulu, Penjaga Bumi! 🌍");
        return;
      }

      state.playerName = name;
      localStorage.setItem("misiLastName", name);
      state.currentIndex = 0;
      state.score = 0;
      state.lives = 3;
      state.combo = 0;
      state.maxCombo = 0;
      state.correct = 0;
      state.wrong = 0;

      prepareQuestions();
      showScreen("gameScreen");
      $("playerName").textContent = state.playerName;
      renderMap();
      loadQuestion();
      playSound("start");
    }

    function showScreen(screenId) {
      document.querySelectorAll(".screen").forEach((screen) => screen.classList.remove("active"));
      $(screenId).classList.add("active");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function getZoneIndex(questionNumber = state.currentIndex) {
      return state.gameQuestions[questionNumber].zone;
    }

    function updateLevel() {
      const zoneIndex = getZoneIndex();
      const zone = zones[zoneIndex];
      $("levelTitle").textContent = zone.level;
      $("zoneName").textContent = `${zone.icon} Zona ${zone.name}`;
    }

    function loadQuestion() {
      clearInterval(state.timer);
      state.answered = false;
      state.hintUsed = false;
      state.timeLeft = 30;

      updateLevel();
      updateStats();
      renderQuestion();
      updateTimer();
      state.timer = setInterval(() => {
        state.timeLeft--;
        updateTimer();

        if (state.timeLeft === 10) {
          playSound("warning");
          showToast("⏱️ Waktu tinggal 10 detik!");
        }

        if (state.timeLeft <= 0) {
          clearInterval(state.timer);
          handleTimeout();
        }
      }, 1000);
    }

    function renderQuestion() {
      const current = state.gameQuestions[state.currentIndex];
      const zone = zones[current.zone];
      $("missionTag").textContent = `${zone.icon} MISI ${state.currentIndex + 1} – ${zone.name}`;
      $("questionText").textContent = current.question;
      $("hintStatus").textContent = "Petunjuk tersedia";
      $("hintButton").disabled = false;
      $("feedback").className = "feedback";
      $("feedbackTitle").textContent = "";
      $("feedbackText").textContent = "";
      $("nextButton").textContent = state.currentIndex === 24 ? "🏁 LIHAT HASIL" : "➡️ LANJUTKAN MISI";

      const letters = ["🅰️", "🅱️", "🅲️", "🅳️"];
      $("options").innerHTML = "";

      current.options.forEach((option, index) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "option";
        button.dataset.index = index;
        button.innerHTML = `<strong>${letters[index]}</strong> ${option}`;
        button.setAttribute("aria-label", `Pilihan ${letters[index]}: ${option}`);
        button.addEventListener("click", () => checkAnswer(index));
        $("options").appendChild(button);
      });

      $("progressBar").style.width = `${(state.currentIndex / 25) * 100}%`;
      renderMap();
    }

    function checkAnswer(selectedIndex) {
      if (state.answered) return;
      state.answered = true;
      clearInterval(state.timer);

      const current = state.gameQuestions[state.currentIndex];
      const optionButtons = [...document.querySelectorAll(".option")];
      optionButtons.forEach((button) => {
        button.disabled = true;
      });

      const isCorrect = selectedIndex === current.answer;
      optionButtons[current.answer].classList.add("correct");

      if (isCorrect) {
        state.correct++;
        state.combo++;
        state.maxCombo = Math.max(state.maxCombo, state.combo);

        const earned = updateScore();
        if (state.combo >= 2) playSound("combo");
        else playSound("correct");

        showFeedback(
          true,
          `🎉 BENAR! +${earned} POIN 🔥 COMBO x${state.combo}`,
          current.explanation
        );

        if (state.combo >= 3 || earned >= 180) showConfetti();
      } else {
        optionButtons[selectedIndex].classList.add("wrong");
        state.wrong++;
        state.lives--;
        state.combo = 0;
        updateLives();
        playSound("wrong");

        showFeedback(
          false,
          "❌ BELUM TEPAT!",
          `${current.explanation} Jawaban yang paling tepat adalah: <strong>${current.options[current.answer]}</strong>.`
        );

        if (state.lives <= 0) {
          $("nextButton").textContent = "🏁 LIHAT HASIL";
        }
      }

      updateStats();
    }

    function updateScore() {
      const baseScore = 100;
      const timeBonus = state.timeLeft * 3;
      const comboBonus = (state.combo - 1) * 20;
      const earned = baseScore + timeBonus + comboBonus;
      state.score += earned;
      return earned;
    }

    function updateLives() {
      $("livesValue").textContent = "❤️".repeat(Math.max(0, state.lives)) + "🖤".repeat(3 - Math.max(0, state.lives));
    }

    function updateStats() {
      $("scoreValue").textContent = state.score.toLocaleString("id-ID");
      $("livesValue").textContent = "❤️".repeat(Math.max(0, state.lives)) + "🖤".repeat(3 - Math.max(0, state.lives));
      $("comboValue").textContent = `x${state.combo}`;
      $("questionValue").textContent = `${state.currentIndex + 1}/25`;
      $("correctValue").textContent = state.correct;
    }

    function updateTimer() {
      const timer = $("timerValue");
      timer.textContent = state.timeLeft;
      timer.classList.toggle("timer-danger", state.timeLeft <= 5);
      timer.style.color = state.timeLeft <= 5
        ? "var(--red)"
        : state.timeLeft <= 10
          ? "var(--yellow)"
          : "var(--cyan)";
    }

    function handleTimeout() {
      if (state.answered) return;
      state.answered = true;
      state.wrong++;
      state.lives--;
      state.combo = 0;

      const current = state.gameQuestions[state.currentIndex];
      const optionButtons = [...document.querySelectorAll(".option")];
      optionButtons.forEach((button) => {
        button.disabled = true;
      });
      optionButtons[current.answer].classList.add("correct");

      playSound("warning");
      showFeedback(
        false,
        "⏰ WAKTU HABIS!",
        `${current.explanation} Jawaban yang benar adalah: <strong>${current.options[current.answer]}</strong>.`
      );

      if (state.lives <= 0) $("nextButton").textContent = "🏁 LIHAT HASIL";
      updateStats();
    }

    function showFeedback(isCorrect, title, explanation) {
      const feedback = $("feedback");
      feedback.className = `feedback show ${isCorrect ? "correct-feedback" : "wrong-feedback"}`;
      $("feedbackTitle").innerHTML = title;
      $("feedbackText").innerHTML = explanation;
      feedback.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    function nextQuestion() {
      if (!state.answered) return;

      if (state.lives <= 0 || state.currentIndex >= 24) {
        finishGame();
        return;
      }

      state.currentIndex++;
      loadQuestion();
    }

    function useHint() {
      if (state.hintUsed || state.answered) return;

      const current = state.gameQuestions[state.currentIndex];
      const wrongButtons = [...document.querySelectorAll(".option")]
        .filter((button) => Number(button.dataset.index) !== current.answer && !button.classList.contains("eliminated"));

      if (!wrongButtons.length) return;

      const selected = wrongButtons[Math.floor(Math.random() * wrongButtons.length)];
      selected.classList.add("eliminated");
      state.hintUsed = true;
      state.score = Math.max(0, state.score - 20);
      $("hintButton").disabled = true;
      $("hintStatus").textContent = "Petunjuk sudah digunakan";
      updateStats();
      showToast("💡 Satu pilihan yang salah sudah dihilangkan!");
    }

    function renderMap() {
      const activeZone = getZoneIndex();
      $("map").innerHTML = zones.map((zone, index) => {
        const isDone = index < activeZone || (index === 3 && state.currentIndex >= 24);
        const isActive = index === activeZone && !isDone;

        return `
          <div class="zone-card ${isActive ? "active" : ""} ${isDone ? "done" : ""}">
            <strong>${zone.icon} ${zone.name}</strong>
            <small>${zone.range}</small>
            ${isDone ? "<br><small>✅ SELESAI</small>" : isActive ? "<br><small>✨ SEDANG DIMAINKAN</small>" : ""}
          </div>
        `;
      }).join("");
    }

    function finishGame() {
      clearInterval(state.timer);
      const isNewRecord = saveHighScore();
      const accuracy = Math.round((state.correct / 25) * 100);

      let achievement;
      if (accuracy >= 90) {
        achievement = "🌟 PENJAGA BUMI LEGENDARIS";
      } else if (accuracy >= 75) {
        achievement = "🚀 PENJELAJAH IPAS HEBAT";
      } else if (accuracy >= 60) {
        achievement = "🌱 PENJAGA BUMI MUDA";
      } else {
        achievement = "💪 TERUS BERLATIH";
      }

      $("resultGreeting").textContent = `Selamat, ${state.playerName}! Terima kasih sudah menjaga Bumi.`;
      $("resultScore").textContent = `⭐ ${state.score.toLocaleString("id-ID")} POIN`;
      $("achievement").textContent = achievement;
      $("resultCorrect").textContent = state.correct;
      $("resultWrong").textContent = state.wrong;
      $("resultLives").textContent = state.lives;
      $("resultCombo").textContent = state.maxCombo;
      $("resultAccuracy").textContent = `${accuracy}%`;
      $("certificateName").textContent = state.playerName;
      $("certificateScore").textContent = state.score.toLocaleString("id-ID");
      $("certificateAccuracy").textContent = `${accuracy}%`;
      $("certificateDate").textContent = new Intl.DateTimeFormat("id-ID", {
        dateStyle: "long"
      }).format(new Date());

      $("newRecordText").innerHTML = isNewRecord
        ? '<div class="new-record">🎉 REKOR BARU!</div>'
        : "";

      showScreen("resultScreen");
      playSound("finish");
      showConfetti();
    }

    function restartGame() {
      showScreen("startScreen");
      loadStartRecords();
      $("studentName").focus();
    }

    function showConfetti() {
      const container = $("confettiContainer");
      const colors = ["#4de4e9", "#62e681", "#ffd95a", "#ff647c", "#a98cff"];
      for (let i = 0; i < 80; i++) {
        const piece = document.createElement("span");
        piece.className = "confetti";
        piece.style.left = `${Math.random() * 100}%`;
        piece.style.background = colors[Math.floor(Math.random() * colors.length)];
        piece.style.animationDelay = `${Math.random() * .8}s`;
        piece.style.transform = `rotate(${Math.random() * 360}deg)`;
        container.appendChild(piece);
        setTimeout(() => piece.remove(), 3500);
      }
    }

    function showToast(message) {
      const toast = $("toast");
      toast.textContent = message;
      toast.classList.add("show");
      clearTimeout(showToast.timeout);
      showToast.timeout = setTimeout(() => toast.classList.remove("show"), 2400);
    }

    /*
      Efek suara dibuat dengan Web Audio API.
      Tidak ada file suara eksternal yang digunakan.
    */
    function playSound(type) {
      if (!state.soundOn) return;

      try {
        if (!state.audioContext) {
          state.audioContext = new (window.AudioContext || window.webkitAudioContext)();
        }

        const context = state.audioContext;
        if (context.state === "suspended") context.resume();

        const patterns = {
          correct: [[660, 0], [880, .12]],
          wrong: [[220, 0], [160, .17]],
          warning: [[500, 0], [500, .15], [500, .3]],
          combo: [[523, 0], [659, .1], [784, .2], [1046, .3]],
          start: [[392, 0], [523, .12], [659, .24]],
          finish: [[523, 0], [659, .13], [784, .26], [1046, .39], [1318, .52]]
        };

        const notes = patterns[type] || patterns.correct;
        notes.forEach(([frequency, delay]) => {
          const oscillator = context.createOscillator();
          const gain = context.createGain();
          oscillator.type = type === "wrong" ? "sawtooth" : "sine";
          oscillator.frequency.value = frequency;
          gain.gain.setValueAtTime(.0001, context.currentTime + delay);
          gain.gain.exponentialRampToValueAtTime(.12, context.currentTime + delay + .02);
          gain.gain.exponentialRampToValueAtTime(.0001, context.currentTime + delay + .18);
          oscillator.connect(gain);
          gain.connect(context.destination);
          oscillator.start(context.currentTime + delay);
          oscillator.stop(context.currentTime + delay + .2);
        });
      } catch (error) {
        console.warn("Audio tidak tersedia:", error);
      }
    }

    function toggleSound() {
      state.soundOn = !state.soundOn;
      localStorage.setItem("misiSound", state.soundOn ? "on" : "off");
      $("soundToggle").textContent = state.soundOn ? "🔊 SOUND ON" : "🔇 SOUND OFF";
      if (state.soundOn) playSound("correct");
    }

    $("startForm").addEventListener("submit", (event) => {
      event.preventDefault();
      startGame();
    });

    $("nextButton").addEventListener("click", nextQuestion);
    $("hintButton").addEventListener("click", useHint);
    $("soundToggle").addEventListener("click", toggleSound);
    $("restartButton").addEventListener("click", restartGame);
    $("printButton").addEventListener("click", () => window.print());

    document.addEventListener("keydown", (event) => {
      if (!$("gameScreen").classList.contains("active")) return;

      if (!state.answered && ["1", "2", "3", "4"].includes(event.key)) {
        checkAnswer(Number(event.key) - 1);
      }

      if (event.key.toLowerCase() === "h") {
        useHint();
      }

      if (event.key === "Enter" && state.answered) {
        nextQuestion();
      }
    });

    $("soundToggle").textContent = state.soundOn ? "🔊 SOUND ON" : "🔇 SOUND OFF";
    loadStartRecords();
  </script>
</body>
</html>

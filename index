<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Misi Penjaga Bumi - Game IPAS Kelas 6</title>
  <style>
    :root {
      --bg: #071526;
      --bg-soft: #0d2238;
      --card: rgba(18, 48, 70, .78);
      --card-light: rgba(31, 75, 93, .72);
      --cyan: #4de4e9;
      --green: #62e681;
      --yellow: #ffd95a;
      --red: #ff647c;
      --purple: #a98cff;
      --text: #f4fbff;
      --muted: #a9c5d3;
      --shadow: 0 16px 45px rgba(0, 0, 0, .32);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--text);
      font-family: "Segoe UI", Arial, sans-serif;
      background:
        radial-gradient(circle at 15% 15%, rgba(77, 228, 233, .16), transparent 28%),
        radial-gradient(circle at 85% 85%, rgba(98, 230, 129, .13), transparent 28%),
        linear-gradient(135deg, #06111f, #0a2334 52%, #08231e);
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: .17;
      background-image:
        radial-gradient(#fff 1px, transparent 1px),
        radial-gradient(#fff 1px, transparent 1px);
      background-size: 80px 80px, 130px 130px;
      background-position: 0 0, 35px 55px;
    }

    button,
    input {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .screen {
      display: none;
      min-height: 100vh;
      padding: 28px 16px;
      position: relative;
      z-index: 1;
    }

    .screen.active {
      display: block;
      animation: fadeIn .55s ease;
    }

    .container {
      width: min(1120px, 100%);
      margin: auto;
    }

    .start-layout {
      min-height: calc(100vh - 56px);
      display: grid;
      place-items: center;
    }

    .hero-card,
    .game-card,
    .result-card {
      background: linear-gradient(145deg, rgba(16, 47, 69, .9), rgba(8, 29, 47, .86));
      border: 1px solid rgba(77, 228, 233, .29);
      border-radius: 30px;
      box-shadow: var(--shadow), 0 0 45px rgba(77, 228, 233, .08);
      backdrop-filter: blur(16px);
    }

    .hero-card {
      width: min(800px, 100%);
      padding: clamp(28px, 6vw, 68px);
      text-align: center;
      overflow: hidden;
      position: relative;
    }

    .hero-card::after {
      content: "";
      position: absolute;
      width: 240px;
      height: 240px;
      border-radius: 50%;
      background: rgba(77, 228, 233, .12);
      top: -95px;
      right: -95px;
      filter: blur(3px);
    }

    .earth {
      font-size: clamp(70px, 13vw, 120px);
      display: inline-block;
      filter: drop-shadow(0 0 18px rgba(77, 228, 233, .65));
      animation: float 4s ease-in-out infinite;
    }

    h1,
    h2,
    h3,
    p {
      margin-top: 0;
    }

    h1 {
      margin-bottom: 8px;
      color: var(--cyan);
      letter-spacing: 2px;
      font-size: clamp(2rem, 6vw, 4.3rem);
      line-height: 1;
      text-shadow: 0 0 24px rgba(77, 228, 233, .45);
    }

    .subtitle {
      color: var(--yellow);
      font-size: clamp(1rem, 2.5vw, 1.35rem);
      font-weight: 700;
      margin-bottom: 20px;
    }

    .description {
      color: var(--muted);
      line-height: 1.7;
      max-width: 600px;
      margin: 0 auto 28px;
    }

    .name-form {
      display: flex;
      gap: 10px;
      max-width: 540px;
      margin: auto;
    }

    input[type="text"] {
      flex: 1;
      min-width: 0;
      padding: 16px 18px;
      color: var(--text);
      background: rgba(0, 0, 0, .27);
      border: 1px solid rgba(169, 140, 255, .48);
      border-radius: 14px;
      outline: none;
    }

    input[type="text"]:focus {
      border-color: var(--cyan);
      box-shadow: 0 0 0 3px rgba(77, 228, 233, .15);
    }

    .primary-btn,
    .secondary-btn,
    .hint-btn,
    .next-btn {
      border: 0;
      border-radius: 14px;
      padding: 14px 20px;
      min-height: 50px;
      color: #061b28;
      font-weight: 800;
      transition: transform .2s, box-shadow .2s, filter .2s;
    }

    .primary-btn {
      background: linear-gradient(135deg, var(--green), var(--cyan));
      box-shadow: 0 8px 22px rgba(77, 228, 233, .2);
    }

    .secondary-btn {
      background: rgba(77, 228, 233, .15);
      border: 1px solid rgba(77, 228, 233, .45);
      color: var(--text);
    }

    .hint-btn {
      background: linear-gradient(135deg, var(--yellow), #ffb45a);
    }

    .next-btn {
      background: linear-gradient(135deg, var(--cyan), var(--purple));
      margin-top: 18px;
      width: 100%;
    }

    .primary-btn:hover,
    .secondary-btn:hover,
    .hint-btn:hover,
    .next-btn:hover {
      transform: translateY(-3px) scale(1.02);
      filter: brightness(1.1);
      box-shadow: 0 9px 25px rgba(77, 228, 233, .28);
    }

    .records {
      margin-top: 22px;
      color: var(--yellow);
      font-weight: 700;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
      margin-top: 30px;
    }

    .feature {
      padding: 14px 8px;
      border-radius: 16px;
      background: rgba(255, 255, 255, .06);
      border: 1px solid rgba(255, 255, 255, .09);
      font-size: .88rem;
      color: var(--muted);
    }

    .feature strong {
      display: block;
      color: var(--text);
      font-size: 1.18rem;
      margin-bottom: 5px;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 18px;
      flex-wrap: wrap;
    }

    .brand {
      color: var(--cyan);
      font-size: clamp(1.2rem, 3vw, 1.65rem);
      font-weight: 900;
    }

    .sound-btn {
      min-height: 42px;
      border-radius: 12px;
      padding: 9px 13px;
      color: var(--text);
      background: rgba(255, 255, 255, .08);
      border: 1px solid rgba(255, 255, 255, .2);
    }

    .level-box {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      background: rgba(255, 255, 255, .07);
      padding: 13px 17px;
      border-radius: 16px;
      margin-bottom: 12px;
      border: 1px solid rgba(255, 255, 255, .1);
    }

    .level-title {
      color: var(--yellow);
      font-weight: 800;
    }

    .zone-name {
      color: var(--muted);
      font-size: .92rem;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 9px;
      margin-bottom: 15px;
    }

    .stat {
      min-width: 0;
      padding: 12px 10px;
      text-align: center;
      border-radius: 14px;
      background: rgba(0, 0, 0, .2);
      border: 1px solid rgba(255, 255, 255, .08);
    }

    .stat-label {
      display: block;
      color: var(--muted);
      font-size: .75rem;
      margin-bottom: 4px;
    }

    .stat-value {
      color: var(--text);
      font-size: clamp(1rem, 2.7vw, 1.35rem);
      font-weight: 900;
      white-space: nowrap;
    }

    #scoreValue {
      color: var(--yellow);
    }

    #livesValue {
      color: var(--red);
    }

    #comboValue {
      color: #ff9f4c;
    }

    #timerValue {
      color: var(--cyan);
    }

    .timer-danger {
      color: var(--red) !important;
      animation: pulse .8s infinite;
    }

    .progress-wrap {
      height: 15px;
      overflow: hidden;
      margin-bottom: 22px;
      border-radius: 20px;
      background: rgba(255, 255, 255, .1);
      border: 1px solid rgba(255, 255, 255, .12);
    }

    .progress-bar {
      height: 100%;
      width: 0;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--green), var(--cyan), var(--purple));
      transition: width .5s ease;
      box-shadow: 0 0 13px rgba(77, 228, 233, .6);
    }

    .game-card {
      padding: clamp(20px, 4vw, 38px);
      animation: slideUp .5s ease;
    }

    .mission-tag {
      display: inline-block;
      color: #061b28;
      background: linear-gradient(135deg, var(--green), var(--cyan));
      padding: 8px 14px;
      border-radius: 30px;
      font-weight: 900;
      font-size: .9rem;
      margin-bottom: 16px;
    }

    .question {
      font-size: clamp(1.2rem, 3vw, 1.75rem);
      line-height: 1.45;
      margin-bottom: 24px;
    }

    .options {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    .option {
      text-align: left;
      min-height: 68px;
      padding: 15px 18px;
      color: var(--text);
      background: rgba(255, 255, 255, .07);
      border: 1px solid rgba(77, 228, 233, .27);
      border-radius: 15px;
      transition: transform .2s, background .2s, box-shadow .2s;
    }

    .option:hover:not(:disabled),
    .option:focus-visible:not(:disabled) {
      transform: scale(1.025);
      background: rgba(77, 228, 233, .16);
      box-shadow: 0 0 19px rgba(77, 228, 233, .28);
      outline: none;
    }

    .option:disabled {
      cursor: default;
    }

    .option.correct {
      background: rgba(98, 230, 129, .26);
      border-color: var(--green);
      box-shadow: 0 0 22px rgba(98, 230, 129, .35);
    }

    .option.wrong {
      background: rgba(255, 100, 124, .25);
      border-color: var(--red);
      box-shadow: 0 0 22px rgba(255, 100, 124, .32);
    }

    .option.eliminated {
      opacity: .22;
      text-decoration: line-through;
      pointer-events: none;
    }

    .feedback {
      display: none;
      margin-top: 22px;
      padding: 18px;
      border-radius: 16px;
      background: rgba(0, 0, 0, .23);
      border-left: 5px solid var(--cyan);
      animation: slideUp .35s ease;
    }

    .feedback.show {
      display: block;
    }

    .feedback-title {
      font-size: 1.35rem;
      font-weight: 900;
      margin-bottom: 8px;
    }

    .feedback.correct-feedback {
      border-color: var(--green);
    }

    .feedback.wrong-feedback {
      border-color: var(--red);
    }

    .feedback p {
      color: var(--muted);
      line-height: 1.6;
      margin-bottom: 0;
    }

    .mission-tools {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      margin-top: 18px;
    }

    .hint-btn:disabled {
      cursor: not-allowed;
      opacity: .45;
      filter: grayscale(.6);
    }

    .map-title {
      color: var(--cyan);
      margin: 28px 0 12px;
    }

    .map {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    .zone-card {
      min-height: 100px;
      padding: 15px;
      border-radius: 17px;
      background: rgba(255, 255, 255, .06);
      border: 1px solid rgba(255, 255, 255, .12);
      transition: .3s;
    }

    .zone-card.active {
      border-color: var(--cyan);
      box-shadow: 0 0 22px rgba(77, 228, 233, .3);
      transform: translateY(-4px);
    }

    .zone-card.done {
      border-color: var(--green);
      background: rgba(98, 230, 129, .13);
    }

    .zone-card strong {
      display: block;
      margin-bottom: 9px;
    }

    .zone-card small {
      color: var(--muted);
    }

    .result-card {
      width: min(900px, 100%);
      margin: auto;
      padding: clamp(24px, 5vw, 48px);
      text-align: center;
    }

    .result-card h1 {
      font-size: clamp(2rem, 7vw, 4rem);
    }

    .result-score {
      color: var(--yellow);
      font-size: clamp(2rem, 7vw, 4.2rem);
      font-weight: 900;
      margin: 18px 0;
      text-shadow: 0 0 22px rgba(255, 217, 90, .3);
    }

    .achievement {
      padding: 18px;
      margin: 18px auto 24px;
      max-width: 600px;
      border: 1px solid rgba(169, 140, 255, .45);
      border-radius: 17px;
      background: rgba(169, 140, 255, .13);
      color: #e5dfff;
      font-size: 1.25rem;
      font-weight: 900;
    }

    .result-stats {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
      margin: 20px 0 30px;
    }

    .result-stat {
      padding: 15px 8px;
      border-radius: 15px;
      background: rgba(255, 255, 255, .07);
    }

    .result-stat b {
      display: block;
      font-size: 1.4rem;
      color: var(--cyan);
      margin-bottom: 6px;
    }

    .certificate {
      text-align: center;
      padding: 28px;
      margin: 20px auto 26px;
      max-width: 680px;
      border: 2px solid var(--yellow);
      border-radius: 20px;
      background: linear-gradient(135deg, rgba(255, 217, 90, .1), rgba(77, 228, 233, .1));
    }

    .certificate h2 {
      color: var(--yellow);
    }

    .certificate-name {
      font-size: 1.7rem;
      color: var(--cyan);
      font-weight: 900;
      margin: 17px 0;
    }

    .certificate p {
      color: var(--muted);
      line-height: 1.7;
      margin-bottom: 7px;
    }

    .result-actions {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    #confettiContainer {
      position: fixed;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
      z-index: 10;
    }

    .confetti {
      position: absolute;
      top: -20px;
      width: 10px;
      height: 16px;
      animation: fall 2.8s linear forwards;
    }

    .toast {
      position: fixed;
      left: 50%;
      top: 22px;
      z-index: 20;
      transform: translate(-50%, -120px);
      background: rgba(7, 21, 38, .94);
      color: var(--text);
      padding: 14px 20px;
      border: 1px solid var(--cyan);
      border-radius: 13px;
      box-shadow: 0 8px 26px rgba(0, 0, 0, .3);
      transition: transform .35s ease;
      text-align: center;
      font-weight: 800;
    }

    .toast.show {
      transform: translate(-50%, 0);
    }

    .new-record {
      color: var(--yellow);
      font-size: 1.2rem;
      font-weight: 900;
      animation: pulse 1s infinite;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(18px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes float {
      0%, 100% { transform: translateY(0) rotate(-4deg); }
      50% { transform: translateY(-14px) rotate(4deg); }
    }

    @keyframes pulse {
      50% { transform: scale(1.06); }
    }

    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }

    @keyframes fall {
      to {
        transform: translateY(110vh) rotate(720deg);
        opacity: 0;
      }
    }

    @media (max-width: 800px) {
      .stats {
        grid-template-columns: repeat(3, 1fr);
      }

      .map {
        grid-template-columns: repeat(2, 1fr);
      }

      .result-stats {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (max-width: 600px) {
      .screen {
        padding: 16px 10px;
      }

      .hero-card {
        padding: 30px 18px;
      }

      .name-form {
        flex-direction: column;
      }

      .feature-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .feature:last-child {
        grid-column: span 2;
      }

      .game-card {
        padding: 19px 14px;
      }

      .options {
        grid-template-columns: 1fr;
      }

      .map {
        grid-template-columns: 1fr;
      }

      .level-box {
        align-items: flex-start;
        flex-direction: column;
      }

      .result-stats {
        grid-template-columns: repeat(2, 1fr);
      }

      .result-stat:last-child {
        grid-column: span 2;
      }

      .topbar {
        align-items: flex-start;
      }

      .mission-tools {
        flex-direction: column;
      }

      .hint-btn {
        width: 100%;
      }
    }

    @media print {
      body {
        background: white;
        color: #111;
      }

      body::before,
      #startScreen,
      #gameScreen,
      .result-actions,
      #confettiContainer,
      .toast {
        display: none !important;
      }

      #resultScreen {
        display: block !important;
        min-height: auto;
        padding: 0;
      }

      .result-card {
        color: #111;
        box-shadow: none;
        border: 2px solid #111;
        background: white;
      }

      .certificate {
        color: #111;
      }

      .certificate p,
      .achievement {
        color: #222;
      }
    }
  </style>
</head>
<body>
  <main id="startScreen" class="screen active">
    <div class="container start-layout">
      <section class="hero-card">
        <div class="earth" aria-hidden="true">🌍</div>
        <h1>MISI PENJAGA BUMI</h1>
        <div class="subtitle">Game Petualangan IPAS Kelas 6</div>
        <p class="description">
          Jelajahi berbagai misi IPAS, jawab tantangan, kumpulkan poin,
          dan jadilah Penjaga Bumi!
        </p>

        <form id="startForm" class="name-form">
          <input
            id="studentName"
            type="text"
            maxlength="30"
            placeholder="Masukkan nama kamu"
            aria-label="Nama siswa"
            autocomplete="name"
            required
          />
          <button class="primary-btn" type="submit" aria-label="Mulai petualangan">
            🚀 MULAI PETUALANGAN
          </button>
        </form>

        <div class="records">
          🏆 Rekor Terbaik: <span id="highScoreStart">0</span> poin
          <br />
          <small id="gamesPlayedStart"></small>
        </div>

        <div class="feature-grid">
          <div class="feature"><strong>❤️ 3</strong>Nyawa</div>
          <div class="feature"><strong>⭐ 25</strong>Misi</div>
          <div class="feature"><strong>⏱️ 30</strong>Detik</div>
          <div class="feature"><strong>🏆 4</strong>Medali</div>
          <div class="feature"><strong>🔥 Combo</strong>Berantai</div>
        </div>
      </section>
    </div>
  </main>

  <main id="gameScreen" class="screen">
    <div class="container">
      <header class="topbar">
        <div class="brand">🌍 MISI PENJAGA BUMI</div>
        <button id="soundToggle" class="sound-btn" type="button" aria-label="Nyalakan atau matikan suara">
          🔊 SOUND ON
        </button>
      </header>

      <section class="level-box">
        <div>
          <div id="levelTitle" class="level-title">🌱 LEVEL 1 – PENJELAJAH EKOSISTEM</div>
          <div id="zoneName" class="zone-name">Zona Ekosistem</div>
        </div>
        <div>👤 <span id="playerName">Penjaga Bumi</span></div>
      </section>

      <section class="stats" aria-label="Statistik permainan">
        <div class="stat">
          <span class="stat-label">⭐ SKOR</span>
          <span id="scoreValue" class="stat-value">0</span>
        </div>
        <div class="stat">
          <span class="stat-label">❤️ NYAWA</span>
          <span id="livesValue" class="stat-value">❤️❤️❤️</span>
        </div>
        <div class="stat">
          <span class="stat-label">🔥 COMBO</span>
          <span id="comboValue" class="stat-value">x0</span>
        </div>
        <div class="stat">
          <span class="stat-label">🎯 MISI</span>
          <span id="questionValue" class="stat-value">1/25</span>
        </div>
        <div class="stat">
          <span class="stat-label">⏱️ TIMER</span>
          <span id="timerValue" class="stat-value">30</span>
        </div>
        <div class="stat">
          <span class="stat-label">✅ BENAR</span>
          <span id="correctValue" class="stat-value">0</span>
        </div>
      </section>

      <div class="progress-wrap" aria-label="Progress misi">
        <div id="progressBar" class="progress-bar"></div>
      </div>

      <section class="game-card">
        <div id="missionTag" class="mission-tag">🌱 MISI 1 – EKOSISTEM</div>
        <h2 id="questionText" class="question">Pertanyaan akan muncul di sini.</h2>
        <div id="options" class="options"></div>

        <div class="mission-tools">
          <button id="hintButton" class="hint-btn" type="button" aria-label="Gunakan petunjuk">
            💡 PETUNJUK (-20)
          </button>
          <span id="hintStatus" class="zone-name">Petunjuk tersedia</span>
        </div>

        <div id="feedback" class="feedback" aria-live="polite">
          <div id="feedbackTitle" class="feedback-title"></div>
          <p id="feedbackText"></p>
          <button id="nextButton" class="next-btn" type="button">➡️ LANJUTKAN MISI</button>
        </div>
      </section>

      <h2 class="map-title">🗺️ PETA PETUALANGAN</h2>
      <section id="map" class="map" aria-label="Peta zona petualangan"></section>
    </div>
  </main>

  <main id="resultScreen" class="screen">
    <div class="container">
      <section class="result-card">
        <div class="earth" aria-hidden="true">🌍</div>
        <h1>🏆 PETUALANGAN SELESAI!</h1>
        <p id="resultGreeting" class="subtitle">Selamat, Penjaga Bumi!</p>
        <div id="resultScore" class="result-score">⭐ 0 POIN</div>
        <div id="newRecordText"></div>
        <div id="achievement" class="achievement"></div>

        <div class="result-stats">
          <div class="result-stat"><b id="resultCorrect">0</b>✅ Jawaban benar</div>

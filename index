      {
        zone: 3,
        question: "Kegiatan manusia yang dapat memperparah pemanasan global adalah...",
        options: ["Menanam pohon", "Menggunakan transportasi umum", "Membakar banyak bahan bakar fosil", "Menghemat listrik"],
        answer: 2,
        explanation: "Pembakaran bahan bakar fosil menghasilkan gas rumah kaca yang dapat meningkatkan pemanasan global."
      },
      {
        zone: 3,
        question: "Saat terjadi gempa bumi ketika berada di dalam kelas, tindakan yang tepat adalah...",
        options: ["Berlari ke dekat jendela", "Berlindung di bawah meja yang kuat dan melindungi kepala", "Berdiri di bawah lemari", "Menggunakan lift"],
        answer: 1,
        explanation: "Berlindung di bawah meja yang kuat dan melindungi kepala membantu mengurangi risiko terkena benda yang jatuh."
